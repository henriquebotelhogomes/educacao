FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:0.11.25 /uv /uvx /usr/local/bin/

WORKDIR /workspace
COPY pyproject.toml uv.lock README.md ./
COPY apps/api/pyproject.toml ./apps/api/
COPY apps/worker/pyproject.toml ./apps/worker/
COPY apps/api/src ./apps/api/src
RUN uv sync --frozen --no-dev --package mentora-api

COPY apps/api/alembic.ini ./apps/api/alembic.ini
COPY apps/api/migrations ./apps/api/migrations

EXPOSE 8000
CMD ["sh", "-c", "uv run --package mentora-api alembic -c apps/api/alembic.ini upgrade head && uv run --package mentora-api uvicorn tutor_ai.main:app --host 0.0.0.0 --port 8000"]
