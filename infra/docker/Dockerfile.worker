FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:0.11.25 /uv /uvx /usr/local/bin/

WORKDIR /workspace
COPY pyproject.toml uv.lock README.md ./
COPY legacy/streamlit/pyproject.toml legacy/streamlit/README.md ./legacy/streamlit/
COPY apps/api/pyproject.toml ./apps/api/
COPY apps/worker/pyproject.toml ./apps/worker/
COPY apps/worker/src/mentora_worker/__init__.py ./apps/worker/src/mentora_worker/__init__.py
RUN uv sync --frozen --no-dev --package mentora-worker

RUN apt-get update \
    && apt-get install --no-install-recommends --yes build-essential libgl1 libglib2.0-0 libxcb1 \
    && rm -rf /var/lib/apt/lists/*

COPY apps/worker/src ./apps/worker/src

CMD ["uv", "run", "--package", "mentora-worker", "python", "-m", "mentora_worker.main"]
