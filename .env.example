# Aplicações
MENTORA_ENVIRONMENT=development
MENTORA_LOG_LEVEL=INFO
MENTORA_API_PORT=8000
MENTORA_WEB_PORT=3000
MENTORA_INGRESS_PORT=8080
MENTORA_GRAFANA_PORT=3001
MENTORA_TELEMETRY_ENABLED=true
MENTORA_JWT_SECRET=troque-por-um-segredo-de-desenvolvimento-com-32-caracteres
MENTORA_ACCESS_TOKEN_MINUTES=20
MENTORA_REFRESH_TOKEN_DAYS=7
MENTORA_COOKIE_SECURE=false
# Configure estas três variáveis para habilitar Google OAuth no ambiente atual.
# MENTORA_GOOGLE_OAUTH_CLIENT_ID=
# MENTORA_GOOGLE_OAUTH_CLIENT_SECRET=
# MENTORA_GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/api/v1/auth/oauth/google/callback

# Banco de dados: a aplicação usa este usuário sem BYPASSRLS.
POSTGRES_SUPERUSER_PASSWORD=postgres_dev_only
POSTGRES_DB=mentora
POSTGRES_USER=mentora_app
POSTGRES_PASSWORD=mentora_dev_only
MENTORA_DATABASE_URL=postgresql+psycopg://mentora_app:mentora_dev_only@postgres:5432/mentora
MENTORA_POSTGRES_PORT=5433
MENTORA_TEST_DATABASE_URL=postgresql+psycopg://mentora_app:mentora_dev_only@localhost:5433/mentora

# Infraestrutura local
MENTORA_REDIS_URL=redis://redis:6379/0
MENTORA_QDRANT_URL=http://qdrant:6333
MENTORA_MINIO_ENDPOINT=http://minio:9000
MENTORA_MINIO_ACCESS_KEY=minioadmin
MENTORA_MINIO_SECRET_KEY=minioadmin_dev_only
MENTORA_MINIO_BUCKET=mentora-dev
MENTORA_FREE_DOCUMENT_MAX_PAGES=50
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_dev_only
MINIO_BUCKET=mentora-dev

# Observabilidade
MENTORA_OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://otel-collector:4318/v1/traces
OTEL_SERVICE_NAME=mentora-api

# Avaliação RAG (Marco 3.5): mantenha estas chaves apenas no .env local.
# GROQ_API_KEY=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# URLs de desenvolvimento local fora do Docker Compose.
API_INTERNAL_URL=http://localhost:8000
API_PROXY_TARGET=http://localhost:8000
